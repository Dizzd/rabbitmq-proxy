[Unit]
Description=RabbitMQ Proxy Forwarder
After=network-online.target rabbitmq-server.service
Wants=network-online.target

[Service]
Type=simple
User=rabbitmq-proxy
Group=rabbitmq-proxy
ExecStart=/opt/rabbitmq-proxy/rabbitmq-proxy forwarder --config /etc/rabbitmq-proxy/config.yml
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/rabbitmq-proxy

[Install]
WantedBy=multi-user.target
